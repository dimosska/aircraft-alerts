# Copy to .env and replace every CHANGE_ME value locally. Never commit .env.
TZ=Europe/Warsaw
N8N_PORT=5678
N8N_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# Private home data. Values below are intentionally fictitious.
HOME_LAT=50.000000
HOME_LON=19.000000
HOME_ELEVATION_METERS=250

AIRPORT_ICAO=EPKK
ADSB_SOURCE=opensky
ADSB_POLL_INTERVAL_SECONDS=30
OPENSKY_CLIENT_ID=CHANGE_ME_add_locally
OPENSKY_CLIENT_SECRET=CHANGE_ME_add_locally
OPENSKY_SEARCH_RADIUS_KM=50

TRACK_HISTORY_SECONDS=240
TRACK_STATE_TTL_SECONDS=900
MAX_CANDIDATE_ALTITUDE_FEET=5000
MIN_AIRPORT_DISTANCE_KM=8
MIN_DESCENT_RATE_MPS=0.5
MIN_TRUE_TRACK_DEGREES=180
MAX_TRUE_TRACK_DEGREES=270
# ADS-B categories 3-7 retain business jets, airliners, heavy and high-performance aircraft.
# Category 2 (Light, below 15,500 lb) and non-airplane categories are excluded.
AIRCRAFT_ADSB_CATEGORY_ALLOWLIST=3,4,5,6,7
# For category 0/1/missing, retain ICAO operator callsigns such as RYR9DA, LOT123 or NJE123.
ALLOW_OPERATOR_CALLSIGN_FALLBACK=true
# Optional comma-separated exact overrides for aircraft excluded by category.
AIRCRAFT_ICAO24_ALLOWLIST=

NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC_IPHONE_1=CHANGE_ME_random_topic_1_at_least_32_chars
NTFY_TOPIC_IPHONE_2=CHANGE_ME_random_topic_2_at_least_32_chars
NOTIFY_IPHONE_1=true
NOTIFY_IPHONE_2=true
NTFY_PRIORITY=default

# Optional local-only Grafana UI for the Loki logging stack.
GRAFANA_BIND_ADDRESS=0.0.0.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_generate_with_openssl_rand_base64_32
