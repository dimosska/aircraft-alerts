# Copy to .env and replace every CHANGE_ME value locally. Never commit .env.
TZ=Europe/Warsaw
N8N_PORT=5678
N8N_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

REDIS_PASSWORD=CHANGE_ME_generate_with_openssl_rand_hex_32

# Private home data. Values below are intentionally fictitious.
HOME_LAT=50.000000
HOME_LON=19.000000
HOME_ELEVATION_METERS=250

AIRPORT_ICAO=EPKK
ADSB_SOURCE=opensky
ADSB_POLL_INTERVAL_SECONDS=30
OPENSKY_CLIENT_ID=CHANGE_ME_add_locally
OPENSKY_CLIENT_SECRET=CHANGE_ME_add_locally
OPENSKY_SEARCH_RADIUS_KM=90

ALERT_LEAD_TIME_SECONDS=120
ALERT_WINDOW_SECONDS=30
MAX_OVERFLIGHT_DISTANCE_METERS=1500
MIN_PREDICTION_CONFIDENCE=0.75
TRACK_HISTORY_SECONDS=240
TRACK_STATE_TTL_SECONDS=900
MIN_CONFIRMATION_SAMPLES=3
MIN_TRACK_SPAN_SECONDS=50
MAX_TRACK_STDDEV_DEGREES=12
MAX_CPA_ETA_SPREAD_SECONDS=35
MIN_DESCENT_RATE_MPS=0.5
APPROACH_CORRIDOR_HALF_WIDTH_METERS=8000
APPROACH_CORRIDOR_LENGTH_METERS=100000
RUNWAY_HEADING_TOLERANCE_DEGREES=35
FINAL_TURN_EXIT_BEFORE_HOME_METERS=2000
FINAL_TURN_CAPTURE_RADIUS_METERS=4000

NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC_IPHONE_1=CHANGE_ME_random_topic_1_at_least_32_chars
NTFY_TOPIC_IPHONE_2=CHANGE_ME_random_topic_2_at_least_32_chars
NOTIFY_IPHONE_1=true
NOTIFY_IPHONE_2=true
NTFY_PRIORITY=default
